# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Optional HTTP port (default 3000).
PORT=3000

# Set only when running integration tests against test/docker-compose.yml.
# TEST_DATABASE_URL="postgresql://catalog_test:catalog_test@127.0.0.1:55432/ecommerce_catalog_test"
